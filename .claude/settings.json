{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash eng/build.sh *)",
      "Bash(bash eng/test.sh *)",
      "Bash(bash eng/summarize-warnings.sh *)",
      "Bash(bash eng/format.sh)"
    ],
    "deny": [
      "Edit(**/*-lock.json)"
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "dotnet@dotnet-agent-skills": true,
    "dotnet-msbuild@dotnet-agent-skills": true,
    "dotnet-test@dotnet-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "dotnet-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/aetos382/dotnet-skills.git",
        "ref": "fix-lsp-servers-entry"
      }
    }
  }
}
